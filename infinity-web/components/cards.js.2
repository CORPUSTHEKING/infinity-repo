import { Icons } from './icons.js';

export function renderScriptCards(items = []) {
  return `
    <div class="grid" aria-label="Scripts">
      ${items.length ? items.map((item) => `
        <article class="card" data-script-card data-script-id="${item.id || ''}">
          
          <header class="card-top">
            <div>
              <div class="role">${item.author || item.owner || 'INFINITY'}</div>
              <h3 class="name">${item.name || item.title || 'Untitled script'}</h3>
            </div>
          </header>

          <button type="button" style="background: none; border: none; padding: 0; text-align: left; cursor: pointer; color: inherit; font: inherit;" data-script-expand>
            <p class="subtitle" style="margin: 0;">${item.description || item.summary || 'No description provided.'}</p>
          </button>

          <footer style="display: grid; gap: 12px;">
            <div class="pill-row">
              <span>${item.shell || ''}</span>
              <span>${item.language || ''}</span>
              <span>${item.category || ''}</span>
            </div>

            <div class="actions">
              <button type="button" class="btn btn-secondary" data-action="download" title="Download">${Icons.download}</button>
              <button type="button" class="btn btn-secondary" data-action="share" title="Share">${Icons.share}</button>
              <button type="button" class="btn btn-secondary" data-action="request" title="Request">${Icons.request}</button>
              <button type="button" class="btn btn-secondary" data-action="report" title="Report">${Icons.report}</button>
            </div>

            <pre class="mini" style="margin: 0; padding: 12px; background: rgba(255,255,255,0.04); border: 1px solid var(--line); border-radius: 12px; white-space: pre-wrap; word-break: break-all;">${Array.isArray(item.dependencies) ? item.dependencies.join('\n') : (item.dependencies || '')}</pre>
          </footer>
          
        </article>
      `).join('') : '<div class="empty">No scripts loaded yet.</div>'}
    </div>
  `;
}
